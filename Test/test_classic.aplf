 ok←test_classic(folder name);foosrc;foobytes;read;goosrc;goobytes;nsref;z;nsbytes;T;dir;nm;ns;opts;sub;_
 :If 82≠⎕DR''  ⍝ Classic interpreter required for classic QA !
     Log'Not a classic interpreter - not running ',⊃⎕SI
     ok←1 ⋄ :Return
 :EndIf
 3 QMKDIR folder

 ⍝ --- check that key and friends are correctly translated in classic edition
 {}⎕SE.Link.Create name folder
 name'foo'⎕SE.Link.Fix foosrc←' res←foo arg' ' res←{⍺ ⍵}⎕U2338 arg'
 read←NREADALL folder,'/foo.aplf'
 foobytes←32 114 101 115 ¯30 ¯122 ¯112 102 111 111 32 97 114 103 13 10 32 114 101 115 ¯30 ¯122 ¯112 123 ¯30 ¯115 ¯70 32 ¯30 ¯115 ¯75 125 ¯30 ¯116 ¯72 32 97 114 103 13 10
 assert'(read~13 32)≡(foobytes~13 32)' ⍝ Also exclude spaces since source may or may not be preserved "as typed"

 goobytes←1+@8⊢foobytes  ⍝ turn foo into goo
 goosrc←{'g'@6⊢⍵}¨@1⊢foosrc
 goobytes{tie←⍵ ⎕NCREATE 0 ⋄ _←⍺ ⎕NAPPEND tie 83 ⋄ 1:_←⎕NUNTIE tie}folder,'/goo.aplf'
 Notify 'changed' (folder,'/goo.aplf')
 assert'goosrc≡⍥{⍵~¨'' ''}⎕NR ''',name,'.goo'''

 {}⎕SE.Link.Break name
 CleanUp folder name

 ⍝ --- test handling of non-default ⎕AVU
 nsref←⍎name ⎕NS''⊣⎕EX name
 assert'nsref.⎕AVU[60]=8866'       ⍝ Default: right tack
 nsref.⎕FX foosrc←' foo' '⍝⊢'
 {}LinkCreate name folder
 read←NREADALL folder,'/foo.aplf'
 assert'(¯3↑read~13 10)≡¯30 ¯118 ¯94'  ⍝ UTF-8 U+22A2 right tack (ignore CRLF)

 nsref.⎕AVU[60]←164                 ⍝ Now change to map to currency symbol
 {}⎕SE.Link.Add name,'.⎕AVU'        ⍝ Record ⎕AVU
 name'foo'⎕SE.Link.Fix foosrc     ⍝ Refix the function, this should write the file

 read←NREADALL folder,'/foo.aplf'
 assert'(¯2↑read~13 10)≡¯62 ¯92'       ⍝ UTF-8 U+00A4 currency symbol
 {}⎕SE.Link.Break name
 ⎕EX name

 ⍝ Check error messages when TRANSLATION ERROR occurs in Classic (issue #603)
 ⍝ Define :Namespace with comment containing copyright symbol

 nsbytes←¯17 ¯69 ¯65 58 78 97 109 101 83 112 97 99 101 32 105 54 48 51 13 10
 nsbytes,←¯30 ¯115 ¯99 32 ¯62 ¯87 13 10, 58 69 110 100 78 97 109 101 115 112 97 99 101 13 10
 nsbytes {tie←⍵ ⎕NCREATE 0 ⋄ _←⍺ ⎕NAPPEND tie 83 ⋄ 1:_←⎕NUNTIE tie}folder,'/i603.apln'

 assertError 'z←⎕SE.Link.Import name (folder,''/i603.apln'')' '(U+00A9) not in ⎕AVU'

 {}LinkCreate name folder
 assert'foosrc≡⎕NR ''',name,'.foo'''
 assert'nsref.⎕AVU[60]=164'        ⍝ Check ⎕AVU has been set to non-default
 assert'⎕AVU[60]=8866'             ⍝ Check ⎕AVU has not been affected
 assert'#.⎕AVU[60]=8866'           ⍝ Check #.⎕AVU also unchanged

 CleanUp folder name

 ⍝ --- Non-ASCII link directory, file names and flattened subdirectory
 ⍝ Unix Classic writes UTF-8 names as Unicode does, so paths given to it are on-disk names (ClassicNames.ToFS);
 ⍝ elsewhere ToFS changes nothing. Link must not translate the part of a path that is already an on-disk name.
 T←⎕SE.Link.ClassicNames.ToFS
 dir←folder,'/',T'dir',⎕UCS 233 9082                 ⍝ diré⍺
 nm←'caf',⎕UCS 233                                   ⍝ café
 3 ⎕MKDIR dir

 ns←⍎name ⎕NS''                                      ⍝ export, including a system variable (⎕ is not ASCII either)
 ns.⎕FX(' r←',nm)' r←42'
 'sub'ns.⎕NS'' ⋄ ns.sub.var←1 2 3 ⋄ ns.sub.⎕IO←0
 opts←⎕NS'' ⋄ opts.source←'ns'
 z←opts LinkCreate name dir
 assert'~∨/''ERRORS ENCOUNTERED''⍷z'
 z←⎕SE.Link.Add(name,'.sub.var')(name,'.sub.⎕IO')
 assert'⎕NEXISTS dir,''/'',(T nm),''.aplf'''
 assert'⎕NEXISTS dir,''/sub/var.apla'''
 assert'⎕NEXISTS dir,T''/sub/⎕IO.apla'''
 assert'(,⊂dir)≡⊃⎕NINFO⍠1⊢folder,''/*'''            ⍝ nothing written under a doubly translated name

 {}⎕SE.Link.Break name ⋄ ⎕EX name                    ⍝ import back, and write through the link
 z←LinkCreate name dir
 assert'~∨/''ERRORS ENCOUNTERED''⍷z'
 assert'42≡(⍎name)⍎nm'
 assert'1 2 3≡(⍎name).sub.var'
 assert'0≡(⍎name).sub.⎕IO'
 name nm ⎕SE.Link.Fix(' r←',nm)' r←43'
 assert'∨/''43''⍷∊⊃⎕NGET(dir,''/'',(T nm),''.aplf'')1'
 {}⎕SE.Link.Break name ⋄ ⎕EX name ⋄ 3 ⎕NDELETE dir

 sub←'sub',⎕UCS 9082                                 ⍝ sub⍺: flatten with forceFilenames must rename within this subdirectory
 3 ⎕MKDIR dir,'/',T sub
 _←(⊂' r←Goo' 'r←2')⎕NPUT(dir,'/',(T sub),'/goo.aplf')1  ⍝ wrong case: must be renamed to Goo.aplf
 opts←⎕NS'' ⋄ opts.(source flatten forceFilenames)←'dir' 1 1
 z←opts LinkCreate name dir
 assert'~∨/''ERRORS ENCOUNTERED''⍷z'
 assert'2≡(⍎name).Goo'
 assert'⎕NEXISTS dir,''/'',(T sub),''/Goo.aplf'''
 name'Goo'⎕SE.Link.Fix' r←Goo' 'r←3'               ⍝ file name is rebuilt from the tied file's directory
 assert'∨/''r←3''⍷∊⊃⎕NGET(dir,''/'',(T sub),''/Goo.aplf'')1'
 assert'(,⊂dir,''/'',T sub)≡⊃⎕NINFO⍠1⊢dir,''/*'''   ⍝ no other directory created
 {}⎕SE.Link.Break name

 CleanUp folder name
 ok←1
