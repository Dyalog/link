 {
     defaults: {
        secondstimeout: 600,
        platforms: ["win","macx86","macarm","linux_arm","linux"],
        email: "link@dyalog.com",
        dyalogversions: "18-",
        // a regex to extract error messages from output logs, to ∪ over: one line per failed test as Test/Run.aplf prints them
        // under "Failures:" (e.g. "  test_add (watcher) failed: ..."), or the last two lines of an APL error display (a fatal error)
        errorextractor: "^  test_\\w+ \\([a-z]+\\) (failed|error): .*|^.*\n.*\\x{2227}",
        },

   tests: [
        {
            id:"all_18",
            test:"./Test/RunTests.aplf",
            dyalogversions:  "18.2",
            env:{
                DEBUG_LINKQA: "N",
                DYALOGLINK: "${THISPATH}",
                DYALOGSTARTUPSE: "${THISPATH}StartupSession;${THISPATH}qse/StartupSession",
                CITA_APIDEV: 0,
                DYALOGSTARTUPKEEPLINK: 0,
            }
        },
        {
            id:"all_19",
            test:"./Test/RunTests.aplf",
            dyalogversions:  "19-",
            env:{
                DEBUG_LINKQA: "N",
                DYALOGLINK: "${THISPATH}",
                CITA_APIDEV: 0,
                DYALOGSTARTUPKEEPLINK: 0,
          }
        },
     ]
 }
